<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@id/widget_action_buttons"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_current_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Saturday, 4 October"
                android:textColor="#666666"
                android:textSize="10sp" />

            <TextClock
                android:id="@+id/widget_current_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:text="21:39"
                android:textColor="#111111"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_action_buttons"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:orientation="vertical">

            <Button
                android:id="@+id/widget_add_alarm"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_button"
                android:minWidth="48dp"
                android:minHeight="24dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="Add"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="9sp" />

            <Button
                android:id="@+id/widget_open_alarms"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_button"
                android:minWidth="48dp"
                android:minHeight="24dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="Open"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="9sp" />
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_alarm_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#DDDDDD"
            android:dividerHeight="1dp"
            android:fadeScrollbars="false"
            android:clipToPadding="true"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical"
            android:stackFromBottom="false" />

        <TextView
            android:id="@+id/widget_alarm_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No enabled alarms"
            android:textColor="#666666"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
